# Copy to .env for local development. Nothing here is a secret.

# SQLAlchemy URL. Hosts that hand out postgres:// or postgresql:// URLs work as they are.
DATABASE_URL=postgresql+psycopg://localhost:5432/risklens

# Comma-separated origins allowed to call the API from a browser.
# In production set this to the exact frontend origin, for example https://risklens.vercel.app
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Annual risk-free rates used for the Sharpe ratio. These are assumptions, not live data:
# set them to current short-term government bill yields.
RISK_FREE_RATE_USD=0.04
RISK_FREE_RATE_INR=0.065
